# admin 로그인 비밀번호
ADMIN_PASSWORD=changeme

# Upstash Redis (Vercel Marketplace) 접속 정보
# Vercel 대시보드에서 Marketplace → Upstash Redis 통합을 추가하면
# 아래 KV_* 환경변수가 자동으로 주입됩니다.
# 일부 통합은 UPSTASH_REDIS_* 이름으로 주입되며, 둘 다 지원합니다.
# 로컬 개발 시 비워두면 data/local.json 파일로 fallback 됩니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 대안 이름 (마켓플레이스 통합에 따라 이 이름으로 주입될 수도 있음)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
